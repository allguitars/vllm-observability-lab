# Values from the aiDAPTIVLink2 training-slide example. Change them for the H200 host.
PHISON_IMAGE=aidaptiv:vNXUN_2_04_A1
CONTAINER_NAME=phison_MW204_test
HOST_MODEL_DIR=/usr/local/models
HOST_NVME_DIR=/mnt/nvme0
HOST_USER_DIR=/home/user

# Replace with the target MIG UUID returned by `nvidia-smi -L` on the H200 host.
MIG_DEVICE_ID=MIG-REPLACE-WITH-ACTUAL-UUID

# These paths are relative to finetune/container/docker-compose.yml.
FINETUNE_CONFIG_DIR=../configs
FINETUNE_DATASET_DIR=../datasets
FINETUNE_TOOLKIT_DIR=../toolkit
FINETUNE_RUNS_DIR=../runs
