# Python virtual environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Test, coverage, and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environment and secrets
.env
.env.*
!.env.example
finetune/container/compose.env
finetune/configs/env/env_config.yaml

# Runtime metrics and logs
vllm_metrics_*.csv
*.log
# runs/
!finetune/runs/
# finetune/runs/*
!finetune/runs/.gitkeep
# 保留每輪訓練的證據檔（包括 log），但不追蹤模型權重與 checkpoint。
!finetune/runs/**/*.log
finetune/runs/**/trained-model/
# 保留 Toolkit 測試紀錄。
!finetune/toolkit/**/Log/**/*.log

# Local fine-tuning data may be confidential or too large for Git.
finetune/datasets/local/*
!finetune/datasets/local/.gitkeep

# Hugging Face download metadata
.cache/huggingface/

# Project-local agent skills and generated slide artifacts
.agents/
.frontend-slides/
tmp/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
*~
