# OpenAI-compatible LLM 與 vLLM metrics 連線設定。
# 複製此檔為 .env 後，再填入實際值；.env 不會被 Git 追蹤。

# API 服務根網址，需包含 /v1。
# OpenAI： https://api.openai.com/v1
# H200 vLLM： http://<H200_HOST>:5200/v1
LLM_BASE_URL=

# vLLM Prometheus metrics endpoint，通常不包含 /v1。
# 此服務可能和 middleware API 使用不同的 host 或 port。
# 範例：http://<VLLM_HOST>:8000/metrics
VLLM_METRICS_URL=

# 呼叫時使用的模型 ID。
# H200 vLLM 請填 /v1/models 回傳的 data[].id，通常是 --served-model-name。
MODEL_NAME=

# 控制 request body 使用哪個輸出 token 上限欄位。
# OpenAI GPT：max_completion_tokens
# vLLM：max_tokens
TOKEN_LIMIT_PARAMETER_NAME=max_completion_tokens

# 有值時才會傳送 reasoning_effort 欄位；留空代表完全不傳送。
# OpenAI GPT 測試可填 none；Gemma 3 / vLLM 通常留空。
REASONING_EFFORT=none

# API 認證 key。請勿提交真實 key。
# 若 H200 vLLM 啟用 --api-key，請填對應的 key。
OPENAI_API_KEY=
